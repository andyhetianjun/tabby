{
  "name": "tabby",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @tabby/api",
    "dev:mobile": "npm run start -w @tabby/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0"
  }
}
